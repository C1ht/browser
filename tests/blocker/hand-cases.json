{
  "about": "Hand-written network blocking cases. Each expectation is worked out from filter semantics and the rule quoted in 'rule' (from the vendored lists), not from adblock-rust's output. The browser must match every one (tools/runtime/check.py part 7); a failure means the glue between Gecko and the engine is wrong. tools/adblock's reference tool also runs them through adblock-rust and reports any disagreement. 'page' is the document that makes the request; 'top' (default: page) is the tab's page when the request comes from a frame. 'social': the rule is in Fanboy Social, which only blocks in Strict (expectation given for Standard). Kinds: script, image, stylesheet, xhr, fetch, subdocument, beacon, media, font, document (a top-level page load).",
  "cases": [
    {"id": "h01", "page": "http://news.example.com/", "kind": "script", "url": "http://google-analytics.com/analytics.js", "expect": "block",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "host-anchored rule on the host itself; script; third party"},
    {"id": "h02", "page": "http://news.example.com/", "kind": "image", "url": "http://google-analytics.com/logo.png", "expect": "allow",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "the rule names script and xmlhttprequest only"},
    {"id": "h03", "page": "http://news.example.com/", "kind": "fetch", "url": "http://google-analytics.com/data.json", "expect": "block",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "fetch() counts as xmlhttprequest"},
    {"id": "h04", "page": "http://news.example.com/", "kind": "xhr", "url": "http://google-analytics.com/data2.json", "expect": "block",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "XMLHttpRequest"},
    {"id": "h05", "page": "http://www.google-analytics.com/", "kind": "script", "url": "http://google-analytics.com/own.js", "expect": "allow",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "$third-party: the page is on the same site (www. subdomain)"},
    {"id": "h06", "top": "http://news.example.com/", "page": "http://google-analytics.com/", "kind": "script", "url": "http://google-analytics.com/inner.js", "expect": "allow",
     "rule": "||google-analytics.com^$script,third-party,xmlhttprequest", "why": "requested by a frame on the same site; the frame's document is the source, not the tab's page"},
    {"id": "h07", "page": "http://news.example.com/", "kind": "script", "url": "http://securepubads.g.doubleclick.net/pagead/x.js", "expect": "block",
     "rule": "||g.doubleclick.net^", "why": "a subdomain of the anchored host"},
    {"id": "h08", "page": "http://news.example.com/", "kind": "script", "url": "http://notg.doubleclick.net/x.js", "expect": "allow",
     "rule": "||g.doubleclick.net^", "why": "|| anchors at a label boundary; notg.doubleclick.net is not g.doubleclick.net or below it"},
    {"id": "h09", "page": "http://g.doubleclick.net/", "kind": "image", "url": "http://g.doubleclick.net/pixel.gif", "expect": "block",
     "rule": "||g.doubleclick.net^", "why": "no party option: a site's own request is blocked too"},
    {"id": "h10", "page": "http://9gag.com/", "kind": "script", "url": "http://cdn.viously.com/p.js", "expect": "block",
     "rule": "||viously.com^$domain=9gag.com", "why": "$domain= matches the page"},
    {"id": "h11", "page": "http://m.9gag.com/", "kind": "script", "url": "http://cdn.viously.com/p1.js", "expect": "block",
     "rule": "||viously.com^$domain=9gag.com", "why": "$domain= includes subdomains of the listed domain"},
    {"id": "h12", "page": "http://news.example.com/", "kind": "script", "url": "http://cdn.viously.com/p2.js", "expect": "allow",
     "rule": "||viously.com^$domain=9gag.com", "why": "$domain= does not match this page"},
    {"id": "h13", "page": "http://news.example.com/", "kind": "script", "url": "http://www.googletagmanager.com/gtm.js?id=GTM-A", "expect": "block",
     "rule": "||googletagmanager.com^", "why": "host-anchored, no options"},
    {"id": "h14", "page": "http://www.zazzle.com/", "kind": "script", "url": "http://www.googletagmanager.com/gtm.js?id=GTM-B", "expect": "allow",
     "rule": "@@||googletagmanager.com/gtm.js$domain=...|zazzle.com|...", "why": "exception for this page's site overrides ||googletagmanager.com^"},
    {"id": "h15", "page": "http://www.nexon.com/", "kind": "script", "url": "http://www.googletagmanager.com/gtm.js?id=GTM-C", "expect": "block",
     "rule": "||googletagmanager.com/gtm.js$important,domain=nexon.com", "why": "$important wins over the exception that also lists nexon.com"},
    {"id": "h16", "page": "http://www.phileweb.com/", "kind": "script", "url": "http://www.clarity.ms/tag/abc", "expect": "block",
     "rule": "||clarity.ms/tag/$important,script,domain=phileweb.com", "why": "$important wins over @@||clarity.ms/tag/$script,domain=phileweb.com"},
    {"id": "h17", "page": "http://news.example.com/", "kind": "fetch", "url": "http://api.aoneroom.com/wefeed-h5-bff/ad/list", "expect": "block",
     "rule": "||aoneroom.com/wefeed-h5-bff/ad/$xmlhttprequest", "why": "path rule, fetch as xmlhttprequest"},
    {"id": "h18", "page": "http://news.example.com/", "kind": "script", "url": "http://api.aoneroom.com/wefeed-h5-bff/ad/list.js", "expect": "allow",
     "rule": "||aoneroom.com/wefeed-h5-bff/ad/$xmlhttprequest", "why": "type does not match"},
    {"id": "h19", "page": "http://news.example.com/", "kind": "fetch", "url": "http://api.aoneroom.com/wefeed-h5-bff/news/list", "expect": "allow",
     "rule": "||aoneroom.com/wefeed-h5-bff/ad/$xmlhttprequest", "why": "path does not match"},
    {"id": "h20", "page": "http://news.example.com/", "kind": "image", "url": "http://104.154.1.2/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.png", "expect": "block",
     "rule": "/(https?:\\/\\/)104\\.154\\..{100,}/", "why": "regex rule, any type"},
    {"id": "h21", "page": "http://news.example.com/", "kind": "fetch", "url": "http://sstats.bitdefender.com/event", "expect": "allow",
     "rule": "||sstats.bitdefender.com^$important,redirect=noop.txt,xmlhttprequest", "why": "$redirect rules are left out until phase 2; ||stats.bitdefender.com^ does not cover sstats."},
    {"id": "h22", "page": "http://news.example.com/", "kind": "subdocument", "url": "http://www.facebook.com/plugins/like.php?href=x", "expect": "allow", "social": true,
     "rule": "||facebook.com/plugins/like.php?$third-party (Fanboy Social)", "why": "social list: allowed in Standard, blocked in Strict"},
    {"id": "h23", "page": "http://news.example.com/", "kind": "image", "via": "http://redirect.example.net/__redirect?to=http%3A%2F%2Fg.doubleclick.net%2Fpixel2.gif", "url": "http://g.doubleclick.net/pixel2.gif", "expect": "block",
     "rule": "||g.doubleclick.net^", "why": "an allowed URL redirecting to a blocked one: the redirect target is checked"},
    {"id": "h24", "page": "http://news.example.com/", "kind": "document", "url": "http://news.example.com/smartpop/", "expect": "allow",
     "rule": ".com/smartpop/$document", "why": "top-level pages are not blocked in phase 1 ($document rules; docs/CONTENT-BLOCKING.md)"}
  ]
}

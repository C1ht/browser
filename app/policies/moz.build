# resource:///modules/policies/ is where toolkit's policy engine looks.
EXTRA_JS_MODULES.policies += [
    "Policies.sys.mjs",
    "schema.sys.mjs",
]

# <appdir>/distribution/policies.json (the XREAppDist directory).
FINAL_TARGET_FILES.distribution += ["policies.json"]

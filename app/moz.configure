# browser-wip: a standalone Gecko application built against toolkit/.
#
# Everything that identifies the product lives in this block so that a rename
# is mechanical (see tools/rename.sh).
imply_option("--with-app-name", "browser-wip")
imply_option("--with-app-basename", "browser-wip")
imply_option("MOZ_APP_VENDOR", "browser-wip")
imply_option("MOZ_APP_ID", "{b91e6eea-59c2-49c6-9a5f-155294362e18}")
imply_option("MOZ_APP_PROFILE", "browser-wip")
imply_option("MOZ_APP_REMOTINGNAME", "browser-wip")
imply_option("BROWSER_CHROME_URL", "chrome://browser-wip/content/browser.xhtml")
# Sites see Firefox: the user agent ends in "Firefox/<version>" exactly as
# Firefox's does. Without this Gecko appends "browser-wip/<version>", which
# would single out every user of this browser.
imply_option("MOZ_APP_UA_NAME", "Firefox")

# Toolkit features the app is built on.
imply_option("MOZ_PLACES", True)
imply_option("MOZ_DEDICATED_PROFILES", True)
imply_option("MOZ_BLOCK_PROFILE_DOWNGRADE", True)

# Features that report to, or download from, third parties. They are switched
# off at build time so no pref can turn them back on. Normandy, the messaging
# system, Sync and health reporting are not implied here, and Normandy and the
# messaging system are only built for MOZ_BUILD_APP == "browser".
imply_option("MOZ_TELEMETRY_REPORTING", False)
imply_option("--enable-crashreporter", False)
imply_option("--enable-updater", False)
imply_option("--enable-backgroundtasks", False)
imply_option("--enable-necko-wifi", False)

# No DRM in the first release. Widevine can be added later by building with
# --enable-eme=widevine and adding an on-demand install prompt; nothing else in
# the app depends on EME being absent.
imply_option("--enable-eme", False)

include("../toolkit/moz.configure")

# llvm-dlltool (Windows)
# ==============================================================
# The Windows launcher links Mozilla's freestanding DLL blocklist, which needs
# an import library for ntdll built with llvm-dlltool. Toolkit only looks for
# the tool when building Firefox ("browser"), so look for it here as well.


@depends(target, "--enable-compile-environment")
def wip_want_llvm_dlltool(target, compile_environment):
    return target.os == "WINNT" and compile_environment


check_prog(
    "WIP_LLVM_DLLTOOL",
    ("llvm-dlltool",),
    what="llvm-dlltool",
    when=wip_want_llvm_dlltool,
    paths=clang_search_path,
)


@depends(target, when=wip_want_llvm_dlltool)
def wip_llvm_dlltool_flags(target):
    return [
        "-m",
        {"x86": "i386", "x86_64": "i386:x86-64", "aarch64": "arm64"}[target.cpu],
    ]


set_config("WIP_LLVM_DLLTOOL_FLAGS", wip_llvm_dlltool_flags)


# Bundled fonts (Windows)
# ==============================================================
# Gecko loads fonts from <appdir>/fonts when built with MOZ_BUNDLED_FONTS, but
# toolkit only offers --enable-bundled-fonts to Firefox and Thunderbird. The
# Pages on Windows see the same fonts as Mullvad Browser users (app/fonts/).
# Toolkit's own set_define for this name resolves to nothing for this app, so
# this one does not collide with it.


@depends(target)
def wip_bundled_fonts(target):
    if target.os == "WINNT":
        return True


set_define("MOZ_BUNDLED_FONTS", wip_bundled_fonts)

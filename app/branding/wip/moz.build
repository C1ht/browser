DIRS += ["content", "locales"]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    # GTK picks the window icon from chrome/icons/default/default<size>.png.
    FINAL_TARGET_FILES.chrome.icons.default += [
        "default128.png",
        "default16.png",
        "default32.png",
        "default48.png",
        "default64.png",
    ]

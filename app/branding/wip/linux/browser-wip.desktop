[Desktop Entry]
Type=Application
Version=1.5
Name=browser-wip
GenericName=Web Browser
Comment=Browse the web without being tracked
Exec=browser-wip %u
Icon=browser-wip
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/pdf;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=browser-wip
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=browser-wip --new-window %u

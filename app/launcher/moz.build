# The program is installed as dist/bin/browser-wip next to libxul.
DIST_SUBDIR = ""

GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

# ApplicationData.cpp includes application.ini.h, which changes with every
# build ID. Keeping it in its own file means only that file recompiles.
SOURCES += [
    "ApplicationData.cpp",
    "nsBrowserWipApp.cpp",
]

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["OS_ARCH"] == "WINNT":
    error("Windows support needs the launcher process and sandbox broker; see docs/PLAN.md")

# The browser-wip executable (dist/bin/browser-wip[.exe]). Mirrors the
# program rules in browser/app/moz.build so the Windows startup path matches
# what Mozilla ships.

DIST_SUBDIR = ""

GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

# ApplicationData.cpp includes application.ini.h, which changes with every
# build ID. Keeping it in its own file means only that file recompiles.
SOURCES += [
    "ApplicationData.cpp",
    "nsBrowserWipApp.cpp",
]

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["CC_TYPE"] == "clang-cl":
    # Always enter through wmain, console application or not.
    WIN32_EXE_LDFLAGS += ["-ENTRY:wmainCRTStartup"]

if CONFIG["OS_ARCH"] == "WINNT":
    # Icon and version resources; browser-wip.exe.manifest is embedded
    # automatically because it sits next to the sources.
    RCINCLUDE = "browser-wip.rc"
    DEFINES["APP_ICO"] = '"%s/%s/browser-wip.ico"' % (TOPSRCDIR, CONFIG["MOZ_BRANDING_DIRECTORY"])

    # Mozilla's Windows launcher: launcher process, early DLL blocklist,
    # de-elevation. Generic Gecko code that happens to live under browser/.
    DIRS += ["/browser/app/winlauncher"]
    USE_LIBS += ["winlauncher"]
    LOCAL_INCLUDES += ["/browser/app/winlauncher"]
    OS_LIBS += [
        "advapi32",
        "shell32",
        "uuid",
    ]
    DELAYLOAD_DLLS += [
        "advapi32.dll",
        "oleaut32.dll",
        "ole32.dll",
        "rpcrt4.dll",
        "shell32.dll",
        "version.dll",
    ]
    libpath_flag = "-LIBPATH:" if CONFIG["CC_TYPE"] == "clang-cl" else "-L"
    WIN32_EXE_LDFLAGS += [
        libpath_flag + TOPOBJDIR + "/browser/app/winlauncher/freestanding",
    ]
    # The freestanding blocklist links against ntdll_freestanding.lib. Gecko
    # only generates it for Firefox, so generate it here with Mozilla's script.
    if CONFIG["COMPILE_ENVIRONMENT"]:
        GeneratedFile(
            "%sntdll_freestanding.%s" % (CONFIG["LIB_PREFIX"], CONFIG["LIB_SUFFIX"]),
            script="/browser/app/winlauncher/freestanding/gen_ntdll_freestanding_lib.py",
            inputs=["/browser/app/winlauncher/freestanding/ntdll_freestanding.def"],
            flags=[CONFIG["WIP_LLVM_DLLTOOL"]] + CONFIG["WIP_LLVM_DLLTOOL_FLAGS"],
        )
        WIN32_EXE_LDFLAGS += [libpath_flag + OBJDIR]
    # As for firefox.exe: CET is only enabled for processes without JIT.
    LINK_FLAGS["CETCOMPAT"] = []

if CONFIG["MOZ_SANDBOX"] and CONFIG["OS_ARCH"] == "WINNT":
    LOCAL_INCLUDES += [
        "/security/sandbox/chromium",
        "/security/sandbox/chromium-shim",
    ]
    USE_LIBS += ["sandbox_s"]
    OS_LIBS += [
        "shlwapi",
        "winmm",
    ]
    DELAYLOAD_DLLS += [
        "winmm.dll",
        "user32.dll",
        "userenv.dll",
        "usp10.dll",
    ]

# As for firefox.exe: a smaller default process heap (the CRT heap is what
# Gecko uses), no STL wrappers in the standalone launcher, and a GUI-subsystem
# executable so no console window opens next to the browser.
if CONFIG["OS_ARCH"] == "WINNT" and CONFIG["CC_TYPE"] not in ("clang", "gcc"):
    LDFLAGS += ["/HEAP:0x40000"]

DisableStlWrapping()

if CONFIG["MOZ_ASAN"] or CONFIG["MOZ_DEBUG"]:
    WINCONSOLE = True
else:
    WINCONSOLE = False

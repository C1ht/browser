# packager.mk runs "make -C windows installer" after zipping a Windows build,
# which is where Firefox builds its NSIS installer. browser-wip ships the
# portable zip only for now, so the installer step does nothing.

STANDALONE_MAKEFILE := 1

installer:
	@echo "browser-wip: no Windows installer yet; the zip is the package"

.PHONY: installer

# nsIPasswordVault: the vault core (../vault) for the browser process.

XPIDL_SOURCES += [
    "nsIPasswordVault.idl",
]

XPIDL_MODULE = "browserwip_passwords"

XPCOM_MANIFESTS += [
    "components.conf",
]

SOURCES += [
    "LinuxKeyring.cpp",
    "PasswordVault.cpp",
    "WindowsUnlock.cpp",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    # The system keyring through libsecret (loaded at run time) and GDBus.
    CXXFLAGS += CONFIG["GLIB_CFLAGS"]

if CONFIG["OS_ARCH"] == "WINNT":
    # Windows Hello (KeyCredentialManager through WinRT), the TPM check, and
    # session lock notifications.
    OS_LIBS += [
        "bcrypt",
        "ncrypt",
        "runtimeobject",
        "tbs",
        "wtsapi32",
    ]

LOCAL_INCLUDES += [
    "../vault",
]

FINAL_LIBRARY = "xul"

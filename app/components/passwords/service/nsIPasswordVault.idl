#include "nsISupports.idl"

/**
 * The password vault (PasswordVault.cpp): the vault core in
 * components/passwords/vault, in the parent process only.
 *
 * Every call runs on one background task queue, in the order made, so
 * Argon2id and disk writes never hold up the browser. Each returns a
 * Promise. A failure rejects with an OperationError whose message is the
 * core's status name (bwv_status_name: "auth", "locked", "not-found", ...);
 * messages never carry origins, usernames or passwords.
 *
 * PasswordVault.sys.mjs holds the decrypted index (sites, usernames,
 * times). Passwords stay here, sealed, and come out one at a time: to
 * fill, reveal or copy. Entry ids are 16 bytes, base64url without padding.
 * Master passwords are normalised (NFC) by the caller.
 */
[scriptable, builtinclass, uuid(5d7e1b6a-3c1f-4c55-9a0e-2a8d7f4c9b31)]
interface nsIPasswordVault : nsISupports
{
  /**
   * Opens the vault's directory (created owner-only) and finishes what a
   * crash interrupted. Resolves with JSON: { "exists": vault.bwv is there,
   * "permsFixed": a file or the directory was tightened, "cleanup": tidying
   * up still has to be retried }. Later calls resolve the same way.
   */
  [implicit_jscontext] Promise open(in AUTF8String aDir);

  /**
   * Creates the vault: a new vault key under aPassword, the index aIndex,
   * written to disk. Refused ("state") if a vault already exists. The vault
   * is unlocked afterwards.
   */
  [implicit_jscontext] Promise create(in AUTF8String aPassword, in AUTF8String aIndex);

  /** Unlocks with the master password. Resolves with the index (JSON). */
  [implicit_jscontext] Promise unlock(in AUTF8String aPassword);

  /**
   * Whether aPassword is the master password, checked against the file on
   * disk. Resolves true or false. For reveal, copy and export.
   */
  [implicit_jscontext] Promise checkPassword(in AUTF8String aPassword);

  /** Wipes the keys, the index, the passwords and the captured logins. */
  [implicit_jscontext] Promise lock();

  /** Sets the index and writes the vault (with its passwords) to disk. */
  [implicit_jscontext] Promise save(in AUTF8String aIndex);

  /** The entry's password, sealed to aOrigin. In memory until save(). */
  [implicit_jscontext] Promise setSecret(in ACString aEntryId, in AUTF8String aOrigin,
                                         in AUTF8String aSecret);

  /** Resolves with the entry's password; rejects ("auth") for another origin. */
  [implicit_jscontext] Promise getSecret(in ACString aEntryId, in AUTF8String aOrigin);

  /** Seals the entry's password again for its new origin. */
  [implicit_jscontext] Promise moveSecret(in ACString aEntryId, in AUTF8String aFrom,
                                          in AUTF8String aTo);

  [implicit_jscontext] Promise removeSecret(in ACString aEntryId);

  /**
   * A password from a submitted form, sealed at once under a key that
   * exists only for this session, so it isn't kept as a string while the
   * save prompt is open. Resolves with an id for the calls below. Works
   * while locked (the login is saved after unlocking).
   */
  [implicit_jscontext] Promise sealCapture(in AUTF8String aSecret);

  /** Resolves with the captured password (to show it in the prompt). */
  [implicit_jscontext] Promise openCapture(in ACString aCaptureId);

  /** Makes the captured password the entry's, then drops the capture. */
  [implicit_jscontext] Promise storeCapture(in ACString aCaptureId, in ACString aEntryId,
                                            in AUTF8String aOrigin);

  [implicit_jscontext] Promise dropCapture(in ACString aCaptureId);

  /**
   * Wraps the vault key under a new master password (aCurrent is checked
   * first) and writes the vault. Other unlock methods keep working.
   */
  [implicit_jscontext] Promise changePassword(in AUTF8String aCurrent, in AUTF8String aFresh);

  /**
   * An encrypted copy of the vault, to take to another device or keep
   * (docs/PASSWORDS.md §9): a new vault key, one password slot under
   * aPassphrase (no keyring or Windows Hello), the index aIndex, and the
   * passwords of the entries aIds, sealed to aOrigins. Resolves with the
   * file, base64url without padding. Passwords never pass through JS.
   */
  [implicit_jscontext] Promise exportVault(in AUTF8String aPassphrase, in AUTF8String aIndex,
                                           in Array<ACString> aIds,
                                           in Array<AUTF8String> aOrigins);

  /**
   * Opens an exported vault (aFile, base64url) with its passphrase, beside
   * this one, and resolves with its index (JSON). Rejects with "auth" for a
   * wrong passphrase, and "format", "newer" or "older" for a file it can't
   * read. A second call replaces the first.
   */
  [implicit_jscontext] Promise openImport(in ACString aFile, in AUTF8String aPassphrase);

  /**
   * Copies passwords from the opened import into this vault: the import's
   * entry aSrcIds[i] (sealed to aSrcOrigins[i]) becomes this vault's
   * aDstIds[i], sealed to aDstOrigins[i]. In memory until save().
   */
  [implicit_jscontext] Promise importSecrets(in Array<ACString> aSrcIds,
                                             in Array<AUTF8String> aSrcOrigins,
                                             in Array<ACString> aDstIds,
                                             in Array<AUTF8String> aDstOrigins);

  /** Wipes the opened import. Locking does too. */
  [implicit_jscontext] Promise closeImport();

  /**
   * Windows Hello (docs/PASSWORDS.md §5.3): whether it can unlock here,
   * meaning Windows, Hello set up for this user, and a TPM 2.0. Resolves
   * true or false.
   */
  [implicit_jscontext] Promise helloAvailable();

  /**
   * The unlock methods vault.bwv has besides the master password:
   * JSON { "hello": bool, "recovery": bool, "device": bool } ("device":
   * bound to this computer's TPM).
   */
  [implicit_jscontext] Promise slots();

  /**
   * Adds Windows Hello as a way to unlock: aMasterPassword is checked
   * first, then this vault's Hello key is created and signs the slot's
   * challenge (Hello asks once or twice). The vault must be unlocked; the
   * file is written. Rejects with "auth" (master password), "cancelled"
   * or "provider".
   */
  [implicit_jscontext] Promise enableHello(in AUTF8String aMasterPassword);

  /** Removes the Hello slot, writes the vault, and deletes the Hello key. */
  [implicit_jscontext] Promise disableHello();

  /**
   * Unlocks with Windows Hello: one prompt. Resolves with the index (JSON).
   * Rejects with "no-slot" (not set up), "cancelled", "provider" (no key
   * any more, e.g. after a PIN reset) or "auth" (the slot doesn't open).
   */
  [implicit_jscontext] Promise unlockWithHello();

  /**
   * Windows Hello in place of typing the master password to show or copy
   * one (one prompt): the signature has to open the Hello slot of the
   * vault on disk, as an unlock would. Resolves true, or false when it
   * doesn't open; rejects with "no-slot", "cancelled" or "provider".
   */
  [implicit_jscontext] Promise checkHello();

  /** Whether the vault can be bound to this computer (a TPM 2.0). */
  [implicit_jscontext] Promise deviceBindingAvailable();

  /**
   * This computer only: a key in this computer's TPM is created and its
   * secret added to the master password, so a copy of the vault file
   * doesn't open anywhere else, even with the password. Needs the vault
   * unlocked, aMasterPassword, and a recovery key (the way in if the TPM
   * is cleared or the computer replaced): else rejects with "no-slot".
   */
  [implicit_jscontext] Promise enableDeviceBinding(in AUTF8String aMasterPassword);

  /** Undoes enableDeviceBinding (the master password alone opens it again). */
  [implicit_jscontext] Promise disableDeviceBinding(in AUTF8String aMasterPassword);

  /**
   * Password health, worked out here so the passwords never reach JS: for
   * each entry (aIds[i], sealed to aOrigins[i]), how many other entries
   * have the same password, its length in characters and which kinds of
   * character it has (1 lower case, 2 upper case, 4 digits, 8 anything
   * else). Resolves with that as a JSON array, in the same order:
   * [{ "reused": n, "length": n, "classes": n }, ...].
   */
  [implicit_jscontext] Promise health(in Array<AUTF8String> aIds,
                                      in Array<AUTF8String> aOrigins);

  /**
   * A new recovery key (§6), replacing any old one: aMasterPassword is
   * checked first, the vault (unlocked) is written, and the key is resolved
   * once, as "XXXX-XXXX-…", to show. Rejects with "auth".
   */
  [implicit_jscontext] Promise newRecoveryKey(in AUTF8String aMasterPassword);

  /**
   * Forgotten master password: unlocks with the recovery key aCode, then
   * sets aNewPassword as the master password. Resolves with the index
   * (JSON). Rejects with "no-slot" (no recovery key), "auth" or "arg" (a
   * code that isn't one); the vault stays locked then.
   */
  [implicit_jscontext] Promise unlockWithRecovery(in AUTF8String aCode,
                                                  in AUTF8String aNewPassword);

  /**
   * Start over (§6): vault.bwv (locked) is kept as
   * vault-forgotten-<aDate>.bwv (-2, -3… if taken), its backup beside it,
   * and its Hello key deleted. Resolves with the kept file's name.
   */
  [implicit_jscontext] Promise startOver(in AUTF8String aDate);

  /**
   * Replace encryption key (§4.2), step one: aCurrent (the master password)
   * is checked, then a copy of the vault gets a new vault key, everything
   * sealed again, the password slot under aFresh, a new recovery key and
   * Hello slot where there were ones (Hello asks twice), written to
   * vault.bwv.new and checked from disk. The vault in use is untouched.
   * Resolves with the new recovery key to show, or "" when there was none.
   * Until replaceCommit() or replaceAbort(), saves fail with "busy".
   */
  [implicit_jscontext] Promise replacePrepare(in AUTF8String aCurrent,
                                              in AUTF8String aFresh);

  /**
   * Step two: the new vault replaces the old one. Resolves with "done", or
   * "cleanup" when it's in use but tidying up is left for the next start.
   */
  [implicit_jscontext] Promise replaceCommit();

  /** Drops a prepared replacement: the old vault stays as it was. */
  [implicit_jscontext] Promise replaceAbort();
};

#include "nsISupports.idl"

/**
 * The password vault (PasswordVault.cpp): the vault core in
 * components/passwords/vault, in the parent process only.
 *
 * Every call runs on one background task queue, in the order made, so
 * Argon2id and disk writes never hold up the browser. Each returns a
 * Promise. A failure rejects with an OperationError whose message is the
 * core's status name (bwv_status_name: "auth", "locked", "not-found", ...);
 * messages never carry origins, usernames or passwords.
 *
 * PasswordVault.sys.mjs holds the decrypted index (sites, usernames,
 * times). Passwords stay here, sealed, and come out one at a time: to
 * fill, reveal or copy. Entry ids are 16 bytes, base64url without padding.
 * Master passwords are normalised (NFC) by the caller.
 */
[scriptable, builtinclass, uuid(5d7e1b6a-3c1f-4c55-9a0e-2a8d7f4c9b31)]
interface nsIPasswordVault : nsISupports
{
  /**
   * Opens the vault's directory (created owner-only) and finishes what a
   * crash interrupted. Resolves with JSON: { "exists": vault.bwv is there,
   * "permsFixed": a file or the directory was tightened, "cleanup": tidying
   * up still has to be retried }. Later calls resolve the same way.
   */
  [implicit_jscontext] Promise open(in AUTF8String aDir);

  /**
   * Creates the vault: a new vault key under aPassword, the index aIndex,
   * written to disk. Refused ("state") if a vault already exists. The vault
   * is unlocked afterwards.
   */
  [implicit_jscontext] Promise create(in AUTF8String aPassword, in AUTF8String aIndex);

  /** Unlocks with the master password. Resolves with the index (JSON). */
  [implicit_jscontext] Promise unlock(in AUTF8String aPassword);

  /**
   * Whether aPassword is the master password, checked against the file on
   * disk. Resolves true or false. For reveal, copy and export.
   */
  [implicit_jscontext] Promise checkPassword(in AUTF8String aPassword);

  /** Wipes the keys, the index, the passwords and the captured logins. */
  [implicit_jscontext] Promise lock();

  /** Sets the index and writes the vault (with its passwords) to disk. */
  [implicit_jscontext] Promise save(in AUTF8String aIndex);

  /** The entry's password, sealed to aOrigin. In memory until save(). */
  [implicit_jscontext] Promise setSecret(in ACString aEntryId, in AUTF8String aOrigin,
                                         in AUTF8String aSecret);

  /** Resolves with the entry's password; rejects ("auth") for another origin. */
  [implicit_jscontext] Promise getSecret(in ACString aEntryId, in AUTF8String aOrigin);

  /** Seals the entry's password again for its new origin. */
  [implicit_jscontext] Promise moveSecret(in ACString aEntryId, in AUTF8String aFrom,
                                          in AUTF8String aTo);

  [implicit_jscontext] Promise removeSecret(in ACString aEntryId);

  /**
   * A password from a submitted form, sealed at once under a key that
   * exists only for this session, so it isn't kept as a string while the
   * save prompt is open. Resolves with an id for the calls below. Works
   * while locked (the login is saved after unlocking).
   */
  [implicit_jscontext] Promise sealCapture(in AUTF8String aSecret);

  /** Resolves with the captured password (to show it in the prompt). */
  [implicit_jscontext] Promise openCapture(in ACString aCaptureId);

  /** Makes the captured password the entry's, then drops the capture. */
  [implicit_jscontext] Promise storeCapture(in ACString aCaptureId, in ACString aEntryId,
                                            in AUTF8String aOrigin);

  [implicit_jscontext] Promise dropCapture(in ACString aCaptureId);

  /**
   * Wraps the vault key under a new master password (aCurrent is checked
   * first) and writes the vault. Other unlock methods keep working.
   */
  [implicit_jscontext] Promise changePassword(in AUTF8String aCurrent, in AUTF8String aFresh);
};

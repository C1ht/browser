# The opt-in YouTube ad blocker (docs/CONTENT-BLOCKING.md, "YouTube ads").
EXTRA_JS_MODULES.browserwip += [
    "YouTubeBlocking.sys.mjs",
    "YouTubeBlockingChild.sys.mjs",
    "YouTubeRules.sys.mjs",
]

# resource://gre/modules/browserwip/youtube/scriptlets.js, run in YouTube
# pages by YouTubeBlockingChild.
EXTRA_JS_MODULES.browserwip.youtube += [
    "scriptlets.js",
]

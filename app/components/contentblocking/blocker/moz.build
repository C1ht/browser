# Network blocking with adblock-rust, through the content_classifier_engine
# FFI that every libxul already contains. Nothing in mozilla-central changes.

XPIDL_SOURCES += [
    "nsIBrowserWipBlocker.idl",
]

XPIDL_MODULE = "browserwip_blocker"

XPCOM_MANIFESTS += [
    "components.conf",
]

SOURCES += [
    "AdblockRustEngine.cpp",
    "NetworkBlocker.cpp",
]

FINAL_LIBRARY = "xul"

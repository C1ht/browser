# Passkeys kept by the browser (docs/PASSWORDS.md §20).

XPIDL_SOURCES += [
    "nsIBrowserWipPasskeys.idl",
]

XPIDL_MODULE = "browserwip_passkeys"

XPCOM_MANIFESTS += [
    "components.conf",
]

SOURCES += [
    "PasskeyService.cpp",
]

EXTRA_JS_MODULES.browserwip += [
    "PasskeyFormats.sys.mjs",
    "Passkeys.sys.mjs",
]

FINAL_LIBRARY = "xul"

# The app has no DIST_SUBDIR: its chrome, prefs and localization install into
# the GRE directory and share one omni.ja with toolkit, like Thunderbird.

CONFIGURE_SUBST_FILES += ["installer/Makefile"]

DIRS += [
    "base",
    "components",
    "locales",
    "policies",
    "themes",
    "launcher",
]

if CONFIG["OS_ARCH"] == "WINNT":
    DIRS += ["build/win"]

JS_PREFERENCE_FILES += [
    "profile/browser-wip.js",
]

DEFINES["APP_VERSION"] = CONFIG["MOZ_APP_VERSION"]

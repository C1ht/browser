# Release build. Privacy-relevant options are implied by app/moz.configure,
# so they cannot drift between configs.
ac_add_options --enable-project=browser-wip
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --enable-release
ac_add_options --enable-lto=cross
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-browser-wip-release
